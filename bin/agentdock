workspace_role_template_id() {
  local root="$1" role="$2" prompt_file="$root/.agentdock/prompts/$role.md" template_id=""
  [[ -f "$prompt_file" ]] || return 0
  template_id="$(sed -n 's/^<!-- AgentDock template_id: //p' "$prompt_file" 2>/dev/null | sed 's/ -->$//' | head -1)"
  if [[ -z "$template_id" ]]; then
    template_id="$(sed -n 's/^Based on role template: `\\([^`]*\\)`.*/\\1/p' "$prompt_file" 2>/dev/null | head -1)"
  fi
  template_id="$(sanitize_id "$template_id")"
  [[ "$template_id" == agency-* ]] || return 0
  is_agency_template_id "$template_id" "$root" || return 0
  printf '%s' "$template_id"
}

agency_role_field_or_empty() {
  local root="$1" template_id="$2" field="$3"
  [[ -n "$template_id" ]] || return 0
  agency_registry_field "$root" "$template_id" "$field" 2>/dev/null || true
}

workspace_manager_chain() {
  local role="$1" department
  department="$(workspace_role_department "$role")"
  case "$role" in
    *orchestrator*|ceo) printf 'CEO/%s' "$role" ;;
    *architect*|*system*|*developer*|*engineer*|*dev*) printf 'CEO/CTO/%s/%s' "$department" "$role" ;;
    *product*|*pm*|*ux*|*designer*|*ui*) printf 'CEO/CPO/%s/%s' "$department" "$role" ;;
    *qa*|*test*|*review*) printf 'CEO/Quality Executive/%s/%s' "$department" "$role" ;;
    *delivery*|*planner*|*writer*|*docs*) printf 'CEO/COO/%s/%s' "$department" "$role" ;;
    *finance*|*cfo*|*cost*) printf 'CEO/CFO/%s/%s' "$department" "$role" ;;
    *) printf 'CEO/General/%s' "$role" ;;
  esac
}

workspace_selected_roles_no_write() {
  local job_dir="$1" task id seen=""
  [[ -d "$job_dir/TASKS" ]] || return 0
  while IFS= read -r task; do
    id="$(basename "$task" .md)"
    [[ "$id" == "README" ]] && continue
    case " $seen " in *" $id "*) continue ;; esac
    seen="$seen $id"
    printf '%s\n' "$id"
  done < <(find "$job_dir/TASKS" -maxdepth 1 -type f -name '*.md' 2>/dev/null | sort)
}

workspace_latest_report_for_role() {
  local job_dir="$1" role="$2" report base report_role latest=""
  while IFS= read -r report; do
    base="$(basename "$report" .md)"
    report_role="${base#*-}"
    [[ "$report_role" == "$role" ]] || continue
    latest="$report"
  done < <(find "$job_dir/REPORTS" -maxdepth 1 -type f -name '*.md' ! -name '*-final.md' 2>/dev/null | sort)
  printf '%s' "$latest"
}

workspace_json_array_from_words() {
  local first=1 item
  printf '['
  for item in "$@"; do
    [[ -n "$item" ]] || continue
    [[ "$first" == 1 ]] || printf ','
    json_string "$item"
    first=0
  done
  printf ']'
}

cmd_report() {
  local root json=0 fast=0
  root="$(require_project "$@")"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=1; shift ;;
      --fast) fast=1; shift ;;
      --project) shift 2 ;;
      --project=*) shift ;;
      *) shift ;;
    esac
  done
  source_runtime "$root"
  local current current_path current_dir lifecycle session_status running_panes configured_count
  current="$(cat "$root/.agent-work/07_JOBS/CURRENT.md" 2>/dev/null || true)"
  current_path="$(printf '%s\n' "$current" | sed -n 's/^Active job: //p' | head -1)"
  if [[ -n "$current_path" ]]; then
    current_dir="$(dirname "$current_path")"
    [[ "$current_dir" == /* ]] || current_dir="$root/${current_dir#./}"
  else
    current_dir=""
  fi
  lifecycle="$(grep '^Status:' "$current_dir/LIFECYCLE.md" 2>/dev/null | head -1 | sed 's/^Status:[[:space:]]*//' || true)"
  tmux has-session -t "$SESSION_NAME" 2>/dev/null && session_status="running" || session_status="stopped"
  configured_count="$(printf '%s\n' $AGENT_IDS | wc -l | tr -d ' ')"
  if [[ -f "$root/.agentdock/state/panes.env" ]]; then
    running_panes="$(wc -l < "$root/.agentdock/state/panes.env" | tr -d ' ')"
  else
    running_panes="0"
  fi
  if [[ "$json" == 1 ]]; then
    printf '{"project":%s,"session":%s,"session_status":%s,"configured_roles":%s,"running_panes":%s,"current_job":%s,"lifecycle":%s}\n' "$(json_string "$PROJECT_NAME")" "$(json_string "$SESSION_NAME")" "$(json_string "$session_status")" "$configured_count" "$running_panes" "$(json_string "${current//$'\n'/ }")" "$(json_string "$lifecycle")"
    return
  fi
  if [[ "$fast" == 1 ]]; then
    say "AgentDock Fast Report"
    say "Project: $PROJECT_NAME"
    say "Session: $SESSION_NAME ($session_status)"
    say "Roles: $configured_count configured, $running_panes running pane(s)"
    say "Current job: ${current:-none}"
    [[ -n "$lifecycle" ]] && say "Lifecycle: $lifecycle"
    return 0
  fi
  say "AgentDock Report"
  say "Project: $PROJECT_NAME"
  say "Session: $SESSION_NAME ($session_status)"
  say "Roles: $configured_count configured, $running_panes running pane(s)"
  say "Current job: ${current:-none}"
  [[ -n "$lifecycle" ]] && say "Lifecycle: $lifecycle"
  if [[ -n "$current_dir" && -f "$current_dir/TEAM.md" ]]; then
    say ""
    say "Current team plan:"
    sed -n '1,40p' "$current_dir/TEAM.md"
  fi
  say "Reports:"
  find "$root/.agent-work/10_REPORTS" -type f -name '*.md' 2>/dev/null | sort | tail -10 || true
  if [[ -n "$current_dir" && -d "$current_dir/REPORTS" ]]; then
    find "$current_dir/REPORTS" -type f -name '*.md' 2>/dev/null | sort | tail -10 || true
  fi
}

cmd_inbox() {
  local root role="" limit=10 mark_read=0 unread=0
  root="$(require_project "$@")"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --limit) limit="${2:-10}"; shift 2 ;;
      --mark-read) mark_read=1; shift ;;
      --unread) unread=1; shift ;;
      --project) shift 2 ;;
      --project=*) shift ;;
      *) [[ -z "$role" ]] && role="$(sanitize_id "$1")"; shift ;;
    esac
  done
  source_runtime "$root"
  say "AgentDock Inbox Digest"
  if [[ -n "$role" ]]; then
    role_exists "$root" "$role" || die "unknown role: $role"
    local marker="$root/.agent-work/12_INBOX/$role/.last_read" last="" latest=""
    [[ -f "$marker" ]] && last="$(cat "$marker" 2>/dev/null || true)"
    latest="$(find "$root/.agent-work/12_INBOX/$role" -maxdepth 1 -type f -name '*.md' 2>/dev/null | sort | tail -1)"
    if [[ "$mark_read" == 1 ]]; then
      mkdir -p "$(dirname "$marker")"
      printf '%s\n' "$latest" > "$marker"
      say "Marked read for $role: ${latest:-none}"
      return
    fi
    say "Role: $role"
    local files
    if [[ "$unread" == 1 ]]; then
      say "Unread since: ${last:-beginning}"
      files="$(find "$root/.agent-work/12_INBOX/$role" -maxdepth 1 -type f -name '*.md' 2>/dev/null | sort | awk -v last="$last" 'last == "" || $0 > last' | tail -"$limit")"
    else
      files="$(find "$root/.agent-work/12_INBOX/$role" -maxdepth 1 -type f -name '*.md' 2>/dev/null | sort | tail -"$limit")"
    fi
    printf '%s\n' "$files" | while IFS= read -r file; do
      [[ -n "$file" ]] || continue
      printf '\n## %s\n' "$file"
      sed -n '1,8p' "$file"
      if grep -q '^## Body' "$file"; then
        awk '
          /^## Body[[:space:]]*$/ { in_body=1; next }
          in_body && printed < 4 { print; printed++ }
        ' "$file"
      fi
    done
  else
    local id count latest
    printf '%-22s %-8s %s\n' "Role" "Messages" "Latest"
    for id in $AGENT_IDS; do
      count="$(find "$root/.agent-work/12_INBOX/$id" -maxdepth 1 -type f -name '*.md' 2>/dev/null | wc -l | tr -d ' ')"
      latest="$(find "$root/.agent-work/12_INBOX/$id" -maxdepth 1 -type f -name '*.md' 2>/dev/null | sort | tail -1)"
      printf '%-22s %-8s %s\n' "$id" "$count" "${latest:-none}"
    done
    if [[ -f "$root/.agent-work/14_SHARED_CONTEXT/BROADCASTS.md" ]]; then
      say ""
      say "Recent broadcasts:"
      grep '^## Broadcast ' "$root/.agent-work/14_SHARED_CONTEXT/BROADCASTS.md" | tail -"$limit" || true
    fi
  fi
}

cmd_watch() {
  local root role="${1:-}" interval=2 limit=5 once=0
  shift || true
  root="$(require_project "$@")"
  role="$(sanitize_id "$role")"
  role_exists "$root" "$role" || die "usage: agentdock watch <role> [--interval seconds] [--once]"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --interval) interval="${2:-2}"; shift 2 ;;
      --limit) limit="${2:-5}"; shift 2 ;;
      --once) once=1; shift ;;
      --project) shift 2 ;;
      --project=*) shift ;;
      *) shift ;;
    esac
  done
  while true; do
    cmd_inbox "$role" --unread --limit "$limit" --project "$root"
    cmd_inbox "$role" --mark-read --project "$root" >/dev/null
    [[ "$once" == 1 ]] && break
    sleep "$interval"
  done
}

workspace_html_escape() {
  local value="${1:-}"
  value="${value//&/&amp;}"
  value="${value//</&lt;}"
  value="${value//>/&gt;}"
  value="${value//\"/&quot;}"
  value="${value//\'/&#39;}"
  printf '%s' "$value"
}

