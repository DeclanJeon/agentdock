workspace_task_roles() {
  local job_dir="$1" task id seen=""
  [[ -d "$job_dir/TASKS" ]] || return 0
  while IFS= read -r task; do
    id="$(basename "$task" .md)"
    [[ "$id" == "README" ]] && continue
    case " $seen " in *" $id "*) continue ;; esac
    seen="$seen $id"
    printf '%s\n' "$id"
  done < <(find "$job_dir/TASKS" -maxdepth 1 -type f -name '*.md' 2>/dev/null | sort)
}

workspace_latest_report_for_role() {
  local job_dir="$1" role="$2" report base report_role latest=""
  [[ -d "$job_dir/REPORTS" ]] || return 0
  while IFS= read -r report; do
    base="$(basename "$report" .md)"
    report_role="${base#*-}"
    [[ "$report_role" == "$role" ]] || continue
    latest="$report"
  done < <(find "$job_dir/REPORTS" -maxdepth 1 -type f -name '*.md' ! -name '*-final.md' 2>/dev/null | sort)
  printf '%s' "$latest"
}

workspace_report_count_for_role() {
  local job_dir="$1" role="$2" report base report_role count=0
  [[ -d "$job_dir/REPORTS" ]] || { printf '0'; return; }
  while IFS= read -r report; do
    base="$(basename "$report" .md)"
    report_role="${base#*-}"
    [[ "$report_role" == "$role" ]] || continue
    count=$((count + 1))
  done < <(find "$job_dir/REPORTS" -maxdepth 1 -type f -name '*.md' ! -name '*-final.md' 2>/dev/null | sort)
  printf '%s' "$count"
}

workspace_role_selected() {
  local role="$1" selected="$2"
  case " $selected " in *" $role "*) return 0 ;; esac
  return 1
}

workspace_role_configured() {
  local role="$1" configured="$2"
  case " $configured " in *" $role "*) return 0 ;; esac
  return 1
}

workspace_role_status() {
  local selected="$1" pane_id="$2" task_path="$3" report_path="$4"
  if [[ "$selected" == true && -n "$report_path" ]]; then
    printf 'reported'
  elif [[ "$selected" == true && -n "$task_path" && -n "$pane_id" ]]; then
    printf 'working'
  elif [[ "$selected" == true && -n "$task_path" ]]; then
    printf 'assigned'
  elif [[ -n "$pane_id" ]]; then
    printf 'online'
  else
    printf 'configured'
  fi
}

workspace_redact_text() {
  local value="${1:-}"
  python3 - "$value" <<'PY'
import re, sys
value = sys.argv[1]
value = re.sub(r'(?i)\b([A-Z0-9_]*(?:API_KEY|ACCESS_KEY|SECRET|TOKEN|PASSWORD|PRIVATE_KEY)[A-Z0-9_]*\s*[:=]\s*)[^\s,;]+', r'\1[REDACTED]', value)
value = re.sub(r'(?i)\b(sk-[A-Za-z0-9_-]{8,}|gh[pousr]_[A-Za-z0-9_]{8,}|xox[baprs]-[A-Za-z0-9-]{8,}|AKIA[0-9A-Z]{8,})\b', '[REDACTED_SECRET]', value)
value = re.sub(r'(?is)(raw prompt\s*[:=]?\s*).{160,}', r'\1[REDACTED_LONG_PROMPT]', value)
if len(value) > 600:
    value = value[:600] + '… [redacted long text]'
print(value, end='')
PY
}

workspace_job_request_text() {
  local readme="${1:-}" limit="${2:-1600}"
  [[ -f "$readme" ]] || return 0
  awk '
    /^## User request/ {capture=1; next}
    /^## / && capture {exit}
    capture {print}
  ' "$readme" 2>/dev/null |
    sed -E \
      -e '/^BEGIN_UNTRUSTED_USER_REQUEST$/d' \
      -e '/^END_UNTRUSTED_USER_REQUEST$/d' \
      -e 's/^>[[:space:]]?//' |
    tr '\n' ' ' |
    sed -E 's/[[:space:]]+/ /g; s/^[[:space:]]+//; s/[[:space:]]+$//' |
    cut -c "1-$limit"
}

workspace_latest_report_summary() {
  local report="${1:-}" summary=""
  [[ -f "$report" ]] || { printf ''; return; }
  summary="$(sed -n 's/^Summary:[[:space:]]*//p' "$report" 2>/dev/null | head -1)"
  if [[ -z "$summary" ]]; then
    summary="$(grep -vE '^[[:space:]]*$|^#' "$report" 2>/dev/null | head -1 || true)"
  fi
  workspace_redact_text "$summary"
}

workspace_config_warnings() {
  local root="$1" file name
  for name in org.yml characters.yml; do
    file="$root/.agentdock/workspace/$name"
    [[ -f "$file" ]] || continue
    if ! python3 - "$file" >/dev/null 2>&1 <<'PY'
import re, sys
path = sys.argv[1]
text = open(path, encoding='utf-8').read()
if '\t' in text:
    raise SystemExit(1)
if text.count('[') != text.count(']') or text.count('{') != text.count('}'):
    raise SystemExit(1)
for line in text.splitlines():
    s = line.strip()
    if not s or s.startswith('#'):
        continue
    if not re.match(r'^-?\s*[A-Za-z0-9_.-]+\s*:', s):
        raise SystemExit(1)
PY
    then
      printf 'Invalid .agentdock/workspace/%s; using deterministic workspace defaults.\n' "$name"
    fi
  done
}

workspace_density_label() {
  local count="${1:-0}"
  if (( count >= 50 )); then printf 'crowded'; elif (( count >= 20 )); then printf 'dense'; else printf 'normal'; fi
}

workspace_validate_export_out() {
  local root="$1" out="$2" abs parent base archive
  [[ -n "$out" ]] || die "usage: agentdock workspace export --out <file>"
  [[ "$out" != *'..'* ]] || die "workspace export --out rejects parent traversal"
  [[ ! -L "$out" ]] || die "workspace export --out rejects symlink targets"
  parent="$(dirname "$out")"
  [[ -L "$parent" ]] && die "workspace export --out rejects symlink parent directories"
  abs="$(python3 - "$root" "$out" <<'PY'
import os, sys
root, out = sys.argv[1], sys.argv[2]
print(os.path.abspath(out if os.path.isabs(out) else os.path.join(root, out)))
PY
)"
  archive="$root/.agent-work/11_ARCHIVE/"
  base="$(basename "$abs")"
  if [[ "$abs" == "$root/.agentdock/"* ]]; then
    die "workspace export --out may not overwrite .agentdock coordination/config files"
  fi
  if [[ "$abs" == "$root/.agent-work/"* ]]; then
    if [[ "$abs" != "$archive"* || "$base" != workspace*.html ]]; then
      die "workspace export --out inside .agent-work is limited to .agent-work/11_ARCHIVE/workspace*.html"
    fi
  fi
}

workspace_role_status_reason() {
  local selected="$1" pane_id="$2" task_path="$3" report_path="$4"
  if [[ "$selected" == true && -n "$report_path" ]]; then
    printf 'Selected role has submitted at least one job report.'
  elif [[ "$selected" == true && -n "$task_path" && -n "$pane_id" ]]; then
    printf 'Selected role has a task card and an active pane mapping, but no report yet.'
  elif [[ "$selected" == true && -n "$task_path" ]]; then
    printf 'Selected role has a task card, but no active pane mapping or report yet.'
  elif [[ -n "$pane_id" ]]; then
    printf 'Role is configured and has an active pane mapping.'
  else
    printf 'Role is configured or discovered from job files; no active pane mapping.'
  fi
}

workspace_collect_roles() {
  local root="$1" job_dir="$2" configured="$3" role seen=""
  for role in $configured; do
    case " $seen " in *" $role "*) continue ;; esac
    seen="$seen $role"
    printf '%s\n' "$role"
  done
  if [[ -n "$job_dir" ]]; then
    while IFS= read -r role; do
      [[ -n "$role" ]] || continue
      case " $seen " in *" $role "*) continue ;; esac
      seen="$seen $role"
      printf '%s\n' "$role"
    done < <(workspace_task_roles "$job_dir")
  fi
}

workspace_snapshot_json() {
  local root="$1"
  source_runtime "$root"
  local generated_at project_name session_name job_dir job_readme job_id lifecycle_status lifecycle_path team_path configured selected coordinator final_ready=true final_reason missing_roles="" report_total=0 selected_count=0 selected_worker_count=0 submitted_count=0 role role_count=0 density config_warnings job_request_for_recommendations orchestration_json dependencies_json meetings_json write_conflicts_json communications_json worktrees_json qa_required=false qa_status="not_required" qa_path="" qa_reason="" qa_blocker="" tft_blocker="" recommendation_limit=0 orchestration_mode=""
  generated_at="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  project_name="${PROJECT_NAME:-$(basename "$root")}"; session_name="${SESSION_NAME:-}"
  configured="${AGENT_IDS:-}"
  worktrees_json="$(workspace_worktrees_json "$root")"
  job_dir="$(current_job_dir "$root" 2>/dev/null || true)"
  job_request_for_recommendations=""
  job_readme=""; job_id=""; lifecycle_status="none"; lifecycle_path=""; team_path=""; selected=""; coordinator="$(orchestrator_role "$root")"
  if [[ -n "$job_dir" ]]; then
    job_readme="$job_dir/README.md"
    job_request_for_recommendations="$(workspace_job_request_text "$job_readme" 1600)"
    job_id="$(basename "$job_dir")"
    lifecycle_path="$job_dir/LIFECYCLE.md"
    team_path="$job_dir/TEAM.md"
    orchestration_json="$(workspace_orchestration_json "$job_dir")"
    dependencies_json="$(workspace_dependencies_json "$job_dir")"
    meetings_json="$(workspace_meetings_json "$job_dir")"
    write_conflicts_json="$(workspace_write_conflicts_json "$job_dir")"
    communications_json="$(workspace_communications_json "$job_dir")"
    orchestration_mode="$(orchestration_field "$job_dir/ORCHESTRATION.json" mode legacy_controlled_actions)"
    case "$orchestration_mode" in
      solo_direct) recommendation_limit=0 ;;
      assisted_single_lane) recommendation_limit=1 ;;
      *) recommendation_limit="$(orchestration_field "$job_dir/ORCHESTRATION.json" team_cap 6)" ;;
    esac
    [[ "$recommendation_limit" =~ ^[0-9]+$ ]] || recommendation_limit=0
    (( recommendation_limit > 6 )) && recommendation_limit=6
    if job_requires_qa "$job_dir"; then qa_required=true; qa_path="$job_dir/QA.md"; fi
    qa_status="$(job_qa_status "$job_dir")"
    qa_reason="$({ sed -n 's/^Reason:[[:space:]]*//p' "$job_dir/QA.md" 2>/dev/null || true; } | head -1)"
    lifecycle_status="$(sed -n 's/^Status: //p' "$lifecycle_path" 2>/dev/null | head -1)"
    [[ -n "$lifecycle_status" ]] || lifecycle_status="unknown"
    selected="$(workspace_task_roles "$job_dir" | tr '\n' ' ' | sed 's/[[:space:]]*$//')"
    selected_count="$(printf '%s\n' $selected | sed '/^$/d' | wc -l | tr -d ' ')"
    while IFS= read -r role; do
      [[ -n "$role" ]] || continue
      [[ "$role" == "$coordinator" ]] && continue
      selected_worker_count=$((selected_worker_count + 1))
      if role_has_job_report "$job_dir" "$role"; then
        submitted_count=$((submitted_count + 1))
      else
        final_ready=false
        missing_roles="${missing_roles:+$missing_roles }$role"
      fi
    done < <(workspace_task_roles "$job_dir")
    if [[ "$final_ready" == true ]]; then
      if [[ "$selected_worker_count" -gt 0 ]]; then
        final_reason="All selected worker task roles have submitted reports."
      else
        final_reason="No selected worker task roles require reports; coordinator can finish after self-review."
      fi
    else
      final_reason="Missing job report(s) for selected worker role(s): $missing_roles"
    fi
    qa_blocker="$(job_qa_blocker "$job_dir" || true)"
    if [[ -n "$qa_blocker" ]]; then
      final_ready=false
      final_reason="$qa_blocker"
    fi
    tft_blocker="$(job_tft_blocker "$job_dir" || true)"
    if [[ -n "$tft_blocker" ]]; then
      final_ready=false
      final_reason="$tft_blocker"
    fi
    report_total="$(find "$job_dir/REPORTS" -maxdepth 1 -type f -name '*.md' ! -name '*-final.md' 2>/dev/null | wc -l | tr -d ' ')"
  else
    final_ready=false
    final_reason="No active job found."
    orchestration_json='{"schema_version":"agentdock.orchestration.v1","mode":"idle","complexity":"none","risk":"none","reason":"No active job found.","requires_qa":false,"team_cap":0}'
    dependencies_json='{"schema_version":"agentdock.dependencies.v1","items":[]}'
    meetings_json='{"schema_version":"agentdock.meetings.v1","items":[]}'
    write_conflicts_json='{"schema_version":"agentdock.write_conflicts.v1","items":[]}'
    communications_json='{"schema_version":"agentdock.communications.v1","items":[]}'
  fi
  role_count="$(workspace_collect_roles "$root" "$job_dir" "$configured" | sed '/^$/d' | wc -l | tr -d ' ')"
  density="$(workspace_density_label "$role_count")"
  config_warnings="$(workspace_config_warnings "$root")"

  printf '{\n'
  printf '  "schema_version": "workspace.snapshot.v1",\n'
  printf '  "generated_at": '; json_string "$generated_at"; printf ',\n'
  printf '  "project": {"name": '; json_string "$project_name"; printf ', "root": '; json_string "$root"; printf ', "session": '; json_string "$session_name"; printf ', "session_name": '; json_string "$session_name"; printf '},\n'
  printf '  "job": {"id": '; json_string "$job_id"; printf ', "path": '; json_string "$job_dir"; printf ', "readme_path": '; json_string "$job_readme"; printf ', "lifecycle": '; json_string "$lifecycle_status"; printf ', "lifecycle_status": '; json_string "$lifecycle_status"; printf ', "final_ready": %s, "final_ready_reason": ' "$final_ready"; json_string "$final_reason"; printf '},\n'
  printf '  "reports": {"total": %s, "submitted": %s, "required": %s, "submitted_selected_roles": %s, "required_selected_roles": %s, "selected_roles": %s, "missing_roles": [' "$report_total" "$submitted_count" "$selected_worker_count" "$submitted_count" "$selected_worker_count" "$selected_count"
  local first=1
  for role in $missing_roles; do
    [[ "$first" == 1 ]] || printf ', '
    first=0
    json_string "$role"
  done
  printf ']},\n'
  printf '  "status_taxonomy": {"configured":"configured/discovered without active pane", "online":"configured with active pane", "assigned":"selected task card or live assignment without report", "working":"live or derived active work", "reviewing":"live verification/review status", "reported":"selected role submitted report", "blocked":"live or derived alert when report/summary contains BLOCKED/blocker/failed", "idle":"live idle status", "final_ready":"all selected non-CEO worker roles reported"},\n'
  printf '  "layout": {"role_count": %s, "density": ' "$role_count"; json_string "$density"; printf ', "density_thresholds": {"dense": 20, "crowded": 50}},\n'
  printf '  "alerts": ['
  first=1
  if [[ -n "$missing_roles" ]]; then
    printf '{"type":"missing_report","severity":"warning","summary":'; json_string "$final_reason"; printf '}'
    first=0
  fi
  if [[ -n "$qa_blocker" ]]; then
    [[ "$first" == 1 ]] || printf ', '
    printf '{"type":"qa_gate","severity":"warning","summary":'; json_string "$qa_blocker"; printf ',"next_action":"QA/review role must submit a passing agentdock job report","source_path":'; json_string "$qa_path"; printf '}'
    first=0
  fi
  if [[ -n "$tft_blocker" ]]; then
    [[ "$first" == 1 ]] || printf ', '
    printf '{"type":"blocking_tft","severity":"warning","summary":'; json_string "$tft_blocker"; printf ',"next_action":"Close or resolve the active blocking TFT"}'
    first=0
  fi
  if [[ -n "$job_dir" && -d "$job_dir/TASKS" && "$lifecycle_status" != "complete" ]]; then
    local now_epoch stale_minutes stale_seconds task_epoch task_age task_file
    now_epoch="$(date +%s 2>/dev/null || printf '0')"
    stale_minutes="${AGENTDOCK_STALE_ROLE_MINUTES:-60}"
    stale_seconds=$((stale_minutes * 60))
    for role in $missing_roles; do
      task_file="$job_dir/TASKS/$role.md"
      [[ -f "$task_file" ]] || continue
      task_epoch="$(stat -c %Y "$task_file" 2>/dev/null || printf '0')"
      [[ "$now_epoch" =~ ^[0-9]+$ && "$task_epoch" =~ ^[0-9]+$ && "$now_epoch" -gt 0 && "$task_epoch" -gt 0 ]] || continue
      task_age=$((now_epoch - task_epoch))
      if (( task_age >= stale_seconds )); then
        [[ "$first" == 1 ]] || printf ', '
        printf '{"type":"stale_role","severity":"warning","role":'; json_string "$role"; printf ',"summary":'; json_string "Selected role $role has not reported for ${stale_minutes}+ minutes; send a follow-up or reassign."; printf ',"next_action":"send follow-up or recruit backup","source_path":'; json_string "$task_file"; printf '}'
        first=0
      fi
    done
  fi
  if [[ -n "$job_dir" && -d "$job_dir/REPORTS" ]]; then
    local report summary
    while IFS= read -r report; do
      [[ -n "$report" ]] || continue
      summary="$(workspace_latest_report_summary "$report")"
      if printf '%s\n' "$summary" | grep -Eiq 'blocked|blocker|failed|failure'; then
        [[ "$first" == 1 ]] || printf ', '
        printf '{"type":"blocker","severity":"error","summary":'; json_string "$summary"; printf ',"source_path":'; json_string "$report"; printf '}'
        first=0
      fi
    done < <(find "$job_dir/REPORTS" -maxdepth 1 -type f -name '*.md' ! -name '*-final.md' 2>/dev/null | sort)
  fi
  if [[ -n "$job_dir" ]]; then
    local dep_alerts
    dep_alerts="$(python3 - <<PY
import json
data=json.loads('''$dependencies_json''')
for item in data.get('items', []):
    role=item.get('role') or ''
    waiting=item.get('waiting_on') or ''
    if role and waiting and item.get('status','open') != 'closed':
        print(role + '\t' + waiting + '\t' + (item.get('reason') or 'waiting on dependency') + '\t' + (item.get('source_path') or ''))
PY
)"
    while IFS=$'\t' read -r dep_role dep_waiting dep_reason dep_source; do
      [[ -n "$dep_role" ]] || continue
      [[ "$first" == 1 ]] || printf ', '
      printf '{"type":"dependency","severity":"warning","role":'; json_string "$dep_role"; printf ',"summary":'; json_string "$dep_role waiting on $dep_waiting: $dep_reason"; printf ',"next_action":"CEO should follow up before recruiting backup; create TFT only if the blocker crosses role boundaries","recovery_suggestion":"follow_up_then_tft_if_cross_role","source_path":'; json_string "$dep_source"; printf '}'
      first=0
    done <<< "$dep_alerts"
  fi
  if [[ -n "$job_dir" ]]; then
    local conflict_alerts
    conflict_alerts="$(python3 - <<PY
import json
data=json.loads('''$write_conflicts_json''')
for item in data.get('items', []):
    print((item.get('file') or '') + '\t' + ','.join(item.get('roles') or []))
PY
)"
    while IFS=$'\t' read -r conflict_file conflict_roles; do
      [[ -n "$conflict_file" ]] || continue
      [[ "$first" == 1 ]] || printf ', '
      printf '{"type":"write_conflict","severity":"warning","summary":'; json_string "Shared write scope conflict on $conflict_file: $conflict_roles"; printf ',"next_action":"CEO must coordinate write ownership before parallel edits","recovery_suggestion":"assign_owner_or_split_scope"}'
      first=0
    done <<< "$conflict_alerts"
  fi
  printf '],\n'
  printf '  "commands": {"mode":"controlled-actions", "write_bridge_enabled": false, "allowed_read_commands":["agentdock team","agentdock report --fast","agentdock inbox <role>","agentdock status show --json","agentdock worktree list --json","agentdock worktree status --json","agentdock workspace snapshot --json","agentdock workspace model --json","agentdock workspace perf --json","agentdock job tick --json"], "allowed_actions":["agentdock job --no-attach","agentdock status set --role <role>","agentdock workspace model set","agentdock send <coordinator>","agentdock broadcast --selected","agentdock send <role>","agentdock recruit <role> --template <template>","agentdock job report --from <role>","agentdock job tft create","agentdock job tft close","agentdock job meeting start","agentdock job meeting conclude","agentdock job tick --apply","agentdock job finish","agentdock worktree create --role <role>","agentdock worktree merge --role <role> --yes"]},\n'
  printf '  "orchestration": %s,\n' "$orchestration_json"
  printf '  "dependencies": %s,\n' "$dependencies_json"
  printf '  "meetings": %s,\n' "$meetings_json"
  printf '  "write_conflicts": %s,\n' "$write_conflicts_json"
  printf '  "communications": %s,\n' "$communications_json"
  printf '  "worktrees": %s,\n' "$worktrees_json"
  printf '  "qa": {"required": %s, "status": ' "$qa_required"; json_string "$qa_status"; printf ', "path": '; json_string "$qa_path"; printf ', "reason": '; json_string "$qa_reason"; printf '},\n'
  printf '  "model": '
  workspace_model_state_json
  printf ',\n'
  printf '  "support": {"linux":"supported", "macos":"supported with Bash 4+ and tmux", "windows":"WSL-only/unsupported native"},\n'
  printf '  "org": {"model": "CEO -> department bay -> role", "zones": ['
  local zones=("CEO Office" "Product Bay" "Engineering Bay" "Quality Bay" "Delivery Bay" "Blocker Desk" "Report Desk")
  first=1
  local zone
  for zone in "${zones[@]}"; do
    [[ "$first" == 1 ]] || printf ', '
    first=0
    json_string "$zone"
  done
  printf ']},\n'
  printf '  "team_plan": {"coordinator": '; json_string "$coordinator"; printf ', "selected_roles": ['
  first=1
  for role in $selected; do
    [[ "$first" == 1 ]] || printf ', '
    first=0
    json_string "$role"
  done
  printf '], "required_worker_reports": %s, "submitted_worker_reports": %s, "recommendations": [' "$selected_worker_count" "$submitted_count"
  first=1
  if [[ -n "$job_request_for_recommendations" && "$recommendation_limit" -gt 0 ]]; then
    local rec_template rec_display rec_department rec_archetype rec_score rec_reason
    while IFS=$'\t' read -r rec_template rec_display rec_department rec_archetype rec_score rec_reason; do
      [[ -n "$rec_template" ]] || continue
      [[ "$first" == 1 ]] || printf ', '
      first=0
      printf '{"template_id": '; json_string "$rec_template"
      printf ', "display_name": '; json_string "$rec_display"
      printf ', "department": '; json_string "$rec_department"
      printf ', "archetype": '; json_string "$rec_archetype"
      printf ', "score": %s' "${rec_score:-0}"
      printf ', "reason": '; json_string "$rec_reason"
      printf '}'
    done < <(agency_recommend_templates "$root" "$job_request_for_recommendations" "$recommendation_limit" text)
  fi
  printf '], "policy": "reuse configured/running roles first; recruit missing capabilities only; one report per selected non-coordinator task role"},\n'
  printf '  "tfts": ['
  first=1
  if [[ -n "$job_dir" && -d "$job_dir/TFTS" ]]; then
    local tft_file tft_name tft_members tft_goal tft_status tft_exit member_line member_first
    while IFS= read -r tft_file; do
      [[ -n "$tft_file" ]] || continue
      tft_name="$(sed -n 's/^# TFT:[[:space:]]*//p' "$tft_file" 2>/dev/null | head -1)"
      [[ -n "$tft_name" ]] || tft_name="$(basename "$tft_file" .md)"
      tft_status="$(sed -n 's/^Status:[[:space:]]*//p' "$tft_file" 2>/dev/null | head -1)"
      [[ -n "$tft_status" ]] || tft_status="planned"
      tft_goal="$(sed -n 's/^Goal:[[:space:]]*//p' "$tft_file" 2>/dev/null | head -1)"
      tft_exit="$(sed -n 's/^Exit condition:[[:space:]]*//p' "$tft_file" 2>/dev/null | head -1)"
      [[ "$first" == 1 ]] || printf ', '
      first=0
      printf '{"name": '; json_string "$tft_name"; printf ', "source_path": '; json_string "$tft_file"; printf ', "status": '; json_string "$tft_status"; printf ', "goal": '; json_string "$tft_goal"; printf ', "exit_condition": '; json_string "$tft_exit"; printf ', "members": ['
      member_first=1
      while IFS= read -r member_line; do
        member_line="$(printf '%s' "$member_line" | sed -E 's/^-+[[:space:]]*//; s/[[:space:]]+$//')"
        member_line="$(sanitize_id "$member_line")"
        [[ -n "$member_line" ]] || continue
        [[ "$member_first" == 1 ]] || printf ', '
        member_first=0
        json_string "$member_line"
      done < <(awk '/^## Members/{capture=1; next} /^## / && capture{exit} capture && /^-/{print}' "$tft_file" 2>/dev/null)
      printf ']}'
    done < <(find "$job_dir/TFTS" -maxdepth 1 -type f -name '*.md' 2>/dev/null | sort | head -20)
  fi
  if [[ -n "$job_dir" && -f "$team_path" ]]; then
    while IFS= read -r tft_line; do
      [[ -n "$tft_line" ]] || continue
      local tft_raw tft_name tft_members tft_goal tft_status member_token member_first
      tft_raw="${tft_line#*TFT:}"
      tft_raw="$(printf '%s' "$tft_raw" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')"
      tft_name="$(printf '%s' "$tft_raw" | sed -E 's/[|;].*$//; s/[[:space:]]+$//')"
      tft_members="$(printf '%s' "$tft_raw" | sed -nE 's/.*members?:[[:space:]]*([^|;]+).*/\1/ip' | head -1)"
      tft_goal="$(printf '%s' "$tft_raw" | sed -nE 's/.*goal:[[:space:]]*([^|;]+).*/\1/ip' | head -1)"
      tft_status="$(printf '%s' "$tft_raw" | sed -nE 's/.*status:[[:space:]]*([^|;]+).*/\1/ip' | head -1)"
      [[ -n "$tft_name" ]] || continue
      [[ -n "$tft_status" ]] || tft_status="planned"
      [[ "$first" == 1 ]] || printf ', '
      first=0
      printf '{"name": '; json_string "$tft_name"; printf ', "source_path": '; json_string "$team_path"; printf ', "status": '; json_string "$tft_status"; printf ', "goal": '; json_string "$tft_goal"; printf ', "members": ['
      member_first=1
      if [[ -n "$tft_members" ]]; then
        IFS=',' read -ra tft_member_tokens <<< "$tft_members"
        for member_token in "${tft_member_tokens[@]}"; do
          member_token="$(sanitize_id "$member_token")"
          [[ -n "$member_token" ]] || continue
          [[ "$member_first" == 1 ]] || printf ', '
          member_first=0
          json_string "$member_token"
        done
      fi
      printf ']}'
    done < <(grep -E '(^|[[:space:]])TFT:' "$team_path" 2>/dev/null | head -20)
  fi
  printf '],\n'
  printf '  "history": {"active_job_id": '; json_string "$job_id"; printf ', "recent_jobs": ['
  first=1
  local hist_job hist_id hist_lifecycle hist_reports hist_final hist_readme hist_created hist_request hist_updated
  if [[ -d "$root/.agent-work/07_JOBS" ]]; then
    while IFS= read -r hist_job; do
      [[ -d "$hist_job" ]] || continue
      hist_id="$(basename "$hist_job")"
      hist_readme="$hist_job/README.md"
      hist_lifecycle="$(sed -n 's/^Status: //p' "$hist_job/LIFECYCLE.md" 2>/dev/null | head -1)"
      [[ -n "$hist_lifecycle" ]] || hist_lifecycle="$(sed -n 's/^## Status//p' "$hist_readme" 2>/dev/null | head -1)"
      [[ -n "$hist_lifecycle" ]] || hist_lifecycle="unknown"
      hist_reports="$(find "$hist_job/REPORTS" -maxdepth 1 -type f -name '*.md' ! -name '*-final.md' 2>/dev/null | wc -l | tr -d ' ')"
      hist_final="$(find "$hist_job/REPORTS" -maxdepth 1 -type f -name '*-final.md' 2>/dev/null | sort | tail -1)"
      hist_created="$(sed -n '/^## Created/{n;p;q}' "$hist_readme" 2>/dev/null)"
      hist_request="$(awk '/^## User request/{flag=1; next} /^## /{flag=0} flag {print}' "$hist_readme" 2>/dev/null | sed 's/^```//; s/^BEGIN_UNTRUSTED_USER_REQUEST$//; s/^END_UNTRUSTED_USER_REQUEST$//' | sed '/^$/d' | head -3 | tr '\n' ' ' | tr -cd '\11\12\15\40-\176' | cut -c1-180)"
      hist_updated="$(date -u -d "@$(stat -c %Y "$hist_job" 2>/dev/null || printf '0')" '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || printf '')"
      [[ "$first" == 1 ]] || printf ', '
      first=0
      printf '{"id": '; json_string "$hist_id"; printf ', "path": '; json_string "$hist_job"; printf ', "readme_path": '; json_string "$hist_readme"; printf ', "lifecycle": '; json_string "$hist_lifecycle"; printf ', "created": '; json_string "$hist_created"; printf ', "updated_at": '; json_string "$hist_updated"; printf ', "report_count": %s, "final_report_path": ' "$hist_reports"; json_string "$hist_final"; printf ', "request_preview": '; json_string "$hist_request"; printf '}'
    done < <(find "$root/.agent-work/07_JOBS" -maxdepth 1 -type d -name 'JOB-*' 2>/dev/null | sort | tail -8 | sort -r)
  fi
  printf ']},\n'
  printf '  "roles": [\n'
  first=1
  local pane_id running_pane configured_bool selected_bool task_path latest_report department tier logical_node manager_chain status status_reason avatar source_first report_count template_id agency_source agency_archetype agency_when agency_outputs agency_activity live_line live_state live_summary live_progress live_updated live_job live_age wt_line wt_branch wt_path wt_exists wt_job
  while IFS= read -r role; do
    [[ -n "$role" ]] || continue
    [[ "$first" == 1 ]] || printf ',\n'
    first=0
    configured_bool=false; selected_bool=false
    workspace_role_configured "$role" "$configured" && configured_bool=true
    workspace_role_selected "$role" "$selected" && selected_bool=true
    pane_id="$(cd "$root" && tmux_target_for_role "$role" || true)"
    [[ -n "$pane_id" ]] && running_pane=true || running_pane=false
    task_path=""; [[ -n "$job_dir" && -f "$job_dir/TASKS/$role.md" ]] && task_path="$job_dir/TASKS/$role.md"
    latest_report=""; [[ -n "$job_dir" ]] && latest_report="$(workspace_latest_report_for_role "$job_dir" "$role")"
    report_count=0; [[ -n "$job_dir" ]] && report_count="$(workspace_report_count_for_role "$job_dir" "$role")"
    template_id="$(workspace_role_template_id "$root" "$role")"
    department="$(agency_role_field_or_empty "$root" "$template_id" department)"
    [[ -n "$department" ]] || department="$(workspace_role_department "$role")"
    tier="$(agency_role_field_or_empty "$root" "$template_id" tier)"
    [[ -n "$tier" ]] || tier="$(workspace_role_tier "$role")"
    logical_node="$(workspace_role_logical_node "$role")"
    if [[ "$tier" == ceo ]]; then manager_chain="[]"; else manager_chain="[\"$coordinator\"]"; fi
    status="$(workspace_role_status "$selected_bool" "$pane_id" "$task_path" "$latest_report")"
    status_reason="$(workspace_role_status_reason "$selected_bool" "$pane_id" "$task_path" "$latest_report")"
    live_line="$(role_status_line "$root" "$role" "$job_dir" || true)"
    live_state=""; live_summary=""; live_progress=""; live_updated=""; live_job=""; live_age=""
    if [[ -n "$live_line" ]]; then
      IFS=$'\t' read -r live_state live_summary live_progress live_updated live_job live_age <<< "$live_line"
      case "$live_state" in
        idle|assigned|working|blocked|reviewing|reported|offline)
          status="$live_state"
          status_reason="$(role_status_state_label "$live_state")"
          [[ -n "$live_summary" ]] && status_reason="$status_reason: $live_summary"
          ;;
      esac
    fi
    wt_line="$(worktree_role_line "$root" "$role" || true)"
    wt_branch=""; wt_path=""; wt_exists="false"; wt_job=""
    [[ -n "$wt_line" ]] && IFS=$'\t' read -r wt_branch wt_path wt_exists wt_job <<< "$wt_line"
    avatar="$(agency_role_field_or_empty "$root" "$template_id" visual.avatar)"
    [[ -n "$avatar" ]] || avatar="$(workspace_role_avatar "$role")"
    printf '    {'
    printf '"id": '; json_string "$role"; printf ', "role_id": '; json_string "$role"; printf ', '
    printf '"configured": %s, "selected": %s, "running_pane": %s, ' "$configured_bool" "$selected_bool" "$running_pane"
    printf '"pane_id": '; json_string "$pane_id"; printf ', '
    printf '"task_path": '; json_string "$task_path"; printf ', '
    printf '"latest_report_path": '; json_string "$latest_report"; printf ', '
    printf '"department": '; json_string "$department"; printf ', '
    printf '"tier": '; json_string "$tier"; printf ', '
    printf '"logical_node": false, "logical_node_label": '; json_string "$logical_node"; printf ', '
    printf '"manager_chain": %s, ' "$manager_chain"
    printf '"status": '; json_string "$status"; printf ', '
    printf '"status_reason": '; json_string "$status_reason"; printf ', '
    printf '"live_status": {'
    printf '"state": '; json_string "$live_state"; printf ', '
    printf '"summary": '; json_string "$live_summary"; printf ', '
    printf '"progress": '; if [[ "$live_progress" =~ ^[0-9]+$ ]]; then printf '%s' "$live_progress"; else printf 'null'; fi; printf ', '
    printf '"updated_at": '; json_string "$live_updated"; printf ', '
    printf '"age_seconds": '; if [[ "$live_age" =~ ^[0-9]+$ ]]; then printf '%s' "$live_age"; else printf 'null'; fi
    printf '}, '
    printf '"worktree": {'
    printf '"branch": '; json_string "$wt_branch"; printf ', '
    printf '"path": '; json_string "$wt_path"; printf ', '
    printf '"exists": %s, ' "$wt_exists"
    printf '"job_path": '; json_string "$wt_job"
    printf '}, '
    printf '"template_id": '; json_string "$template_id"; printf ', '
    if [[ -n "$template_id" ]]; then
      agency_source="$(agency_role_field_or_empty "$root" "$template_id" source)"
      agency_archetype="$(agency_role_field_or_empty "$root" "$template_id" archetype)"
      agency_when="$(agency_role_field_or_empty "$root" "$template_id" when_to_use)"
      agency_outputs="$(agency_role_field_or_empty "$root" "$template_id" outputs)"
      agency_activity="$(agency_role_field_or_empty "$root" "$template_id" visual.activity)"
      printf '"agency_profile": {'
      printf '"template_id": '; json_string "$template_id"; printf ', '
      printf '"source": '; json_string "$agency_source"; printf ', '
      printf '"archetype": '; json_string "$agency_archetype"; printf ', '
      printf '"when_to_use": '; json_string "$agency_when"; printf ', '
      printf '"outputs": '; json_string "$agency_outputs"; printf ', '
      printf '"activity": '; json_string "$agency_activity"
      printf '}, '
    fi
    printf '"source_paths": ['
    source_first=1
    if [[ -n "$task_path" ]]; then [[ "$source_first" == 1 ]] || printf ', '; source_first=0; json_string "$task_path"; fi
    if [[ -n "$latest_report" ]]; then [[ "$source_first" == 1 ]] || printf ', '; source_first=0; json_string "$latest_report"; fi
    if [[ -n "$team_path" && -f "$team_path" ]]; then [[ "$source_first" == 1 ]] || printf ', '; source_first=0; json_string "$team_path"; fi
    printf '], '
    printf '"avatar": {"style": '; json_string "$avatar"; printf ', "report_count": %s}' "$report_count"
    printf '}'
  done < <(workspace_collect_roles "$root" "$job_dir" "$configured")
  printf '\n  ],\n'
  printf '  "events": ['
  first=1
  local event
  if [[ -f "$root/.agent-work/14_SHARED_CONTEXT/BROADCASTS.md" ]]; then
    while IFS= read -r event; do
      [[ -n "$event" ]] || continue
      event="${event#\#\# }"
      [[ "$first" == 1 ]] || printf ', '
      first=0
      json_string "$event"
    done < <(grep -E '^## Broadcast ' "$root/.agent-work/14_SHARED_CONTEXT/BROADCASTS.md" 2>/dev/null | tail -10)
  fi
  printf '],\n'
  printf '  "locks": {"path": '; json_string "$root/.agent-work/LOCKS.md"; printf ', "present": '
  [[ -f "$root/.agent-work/LOCKS.md" ]] && printf 'true' || printf 'false'
  printf '},\n'
  printf '  "warnings": ['
  first=1
  if [[ -z "$job_dir" ]]; then json_string "No active job found"; first=0; fi
  if [[ "$final_ready" != true && -n "$missing_roles" ]]; then [[ "$first" == 1 ]] || printf ', '; json_string "$final_reason"; first=0; fi
  if [[ -n "${config_warnings:-}" ]]; then
    while IFS= read -r warning; do
      [[ -n "$warning" ]] || continue
      [[ "$first" == 1 ]] || printf ', '
      json_string "$warning"
      first=0
    done <<< "$config_warnings"
  fi
  if [[ -n "$job_dir" ]]; then
    local missing_task_roles
    missing_task_roles="$(python3 - "$job_dir" <<'PY'
import json, sys
from pathlib import Path
job=Path(sys.argv[1])
try:
    data=json.loads((job/'ORCHESTRATION.json').read_text(encoding='utf-8'))
except Exception:
    data={}
for role in data.get('selected_roles') or []:
    if role and not (job/'TASKS'/f'{role}.md').exists():
        print(role)
PY
)"
    while IFS= read -r role; do
      [[ -n "$role" ]] || continue
      [[ "$first" == 1 ]] || printf ', '
      json_string "Selected role $role has no task card; CEO should create TASKS/$role.md or remove the selection."
      first=0
    done <<< "$missing_task_roles"
  fi
  printf ']\n'
  printf '}\n'
}

workspace_export_html() {
  local root="$1" out="$2" tmp
  [[ -n "$out" ]] || die "usage: agentdock workspace export --out <file>"
  workspace_validate_export_out "$root" "$out"
  tmp="$(mktemp "${TMPDIR:-/tmp}/agentdock-workspace.XXXXXX")"
  workspace_snapshot_json "$root" > "$tmp"
  mkdir -p "$(dirname "$out")"
  python3 - "$tmp" "$root" "$out" "$INSTALL_ROOT" <<'PY'
import html
import json
import sys
from pathlib import Path

snapshot_path = Path(sys.argv[1])
out = Path(sys.argv[3])
data = json.loads(snapshot_path.read_text(encoding="utf-8"))


def esc(value):
    return html.escape(str(value), quote=True)

roles = data.get("roles", [])
density = data.get("layout", {}).get("density", "normal")
job = data.get("job", {})
project = data.get("project", {})
final_ready = "ready" if job.get("final_ready") else "not ready"
final_reason = job.get("final_ready_reason", "")

zones = [
    ("CEO", lambda r: r.get("tier") == "ceo" or r.get("department") == "Executive"),
    ("Product", lambda r: "Product" in r.get("department", "") or "UX" in r.get("department", "")),
    ("Engineering", lambda r: "Engineering" in r.get("department", "") or "Architecture" in r.get("department", "")),
    ("Quality", lambda r: "Quality" in r.get("department", "") or "QA" in r.get("id", "").upper()),
    ("Delivery", lambda r: "Delivery" in r.get("department", "") or "delivery" in r.get("id", "")),
]

assigned = set()
zone_cards = []
for zone_name, predicate in zones:
    members = []
    for i, role in enumerate(roles, start=1):
        if id(role) in assigned:
            continue
        if predicate(role):
            assigned.add(id(role))
            members.append((i, role))
    zone_cards.append((zone_name, members))
remaining = [(i, r) for i, r in enumerate(roles, start=1) if id(r) not in assigned]
if remaining:
    zone_cards.append(("General", remaining))

css = """
:root{color-scheme:dark;--bg:#0b1220;--panel:#121b2f;--panel2:#0f172a;--line:#334155;--text:#e5eefb;--muted:#94a3b8;--green:#86efac;--yellow:#fde68a;--red:#fca5a5;--blue:#93c5fd}
*{box-sizing:border-box}body{font-family:ui-sans-serif,system-ui;background:var(--bg);color:var(--text);margin:0;padding:24px}.top{display:flex;gap:12px;align-items:center;flex-wrap:wrap}.badge{border:1px solid var(--line);border-radius:999px;padding:4px 10px;background:#08111f}.grid{display:grid;grid-template-columns:minmax(0,2fr) minmax(280px,1fr);gap:18px}.bay{border:1px solid var(--line);border-radius:14px;padding:16px;margin:12px 0;background:var(--panel)}.role-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px}.role{border:1px solid #475569;border-radius:12px;padding:10px;background:var(--panel2);min-height:112px}.role.ready{border-color:#166534}.role.running{border-color:#1d4ed8}.role.blocked{border-color:#991b1b}.role.assigned{border-color:#a16207}.glyph{font-size:28px;line-height:1;text-align:center;margin-bottom:8px}.role-name{font-weight:800;text-align:center;word-break:break-word}.status{font-size:12px;text-align:center;margin-top:4px}.ready .status{color:var(--green)}.running .status{color:var(--blue)}.blocked .status{color:var(--red)}.assigned .status{color:var(--yellow)}.meta{font-size:11px;color:var(--muted);text-align:center;margin-top:4px}.muted{color:var(--muted)}pre{white-space:pre-wrap;background:#08111f;border-radius:12px;padding:12px;max-height:360px;overflow:auto}.desk-list{margin:0;padding-left:18px}@media(max-width:900px){.grid{grid-template-columns:1fr}}
"""

def glyph_for(role):
    state = str(role.get("status", "assigned"))
    if state == "blocked":
        return "▲"
    if state in {"working", "running"}:
        return "●"
    if state in {"reported", "ready", "done"}:
        return "✓"
    return "◆"

parts = []
parts.append('<!doctype html>')
parts.append('<html lang="en"><head><meta charset="utf-8"><title>AgentDock Workspace Export</title>')
parts.append(f'<style>{css}</style></head><body class="density-{esc(density)}">')
parts.append('<div class="top" role="banner" aria-label="AgentDock workspace summary">')
parts.append('<h1>AgentDock Workspace Export</h1>')
parts.append('<span class="badge">CLI-only read-only snapshot</span>')
parts.append(f'<span class="badge">Project: {esc(project.get("name", ""))}</span>')
parts.append(f'<span class="badge">Job: {esc(job.get("id", ""))}</span>')
parts.append(f'<span class="badge">Roles: {len(roles)}</span>')
parts.append('</div>')
parts.append(f'<section class="bay" aria-label="Final readiness"><h2>Final readiness: {esc(final_ready)}</h2><p><strong>Status reason</strong>: {esc(final_reason)}</p></section>')
parts.append('<div class="grid"><main aria-label="Workspace role zones">')
for zone_name, members in zone_cards:
    parts.append(f'<section class="bay" aria-label="{esc(zone_name)}"><h2>{esc(zone_name)}</h2>')
    if not members:
        parts.append('<p class="muted">No active role in this zone.</p>')
    else:
        parts.append('<div class="role-grid">')
        for _, role in members:
            status = role.get("status", "assigned")
            cls = "blocked" if status == "blocked" else status
            role_id = role.get("id", "role")
            parts.append(f'<article class="role {esc(cls)}" aria-label="{esc(role_id)} status {esc(status)}">')
            parts.append(f'<div class="glyph" aria-hidden="true">{esc(glyph_for(role))}</div>')
            parts.append(f'<div class="role-name">{esc(role_id)}</div>')
            parts.append(f'<div class="status">{esc(status)}</div>')
            parts.append(f'<div class="meta">{esc(role.get("department", ""))}</div>')
            summary = role.get("summary") or role.get("live_status", {}).get("summary") or ""
            if summary:
                parts.append(f'<div class="meta">{esc(summary)}</div>')
            parts.append('</article>')
        parts.append('</div>')
    parts.append('</section>')
parts.append('<section class="bay" aria-label="Blockers and warnings"><h2>Blockers and warnings</h2>')
alerts = data.get("alerts", [])
warnings = data.get("warnings", [])
if alerts or warnings:
    parts.append('<ul class="desk-list">')
    for item in [*alerts, *warnings]:
        if isinstance(item, dict):
            message = item.get("message") or item.get("summary") or item.get("type") or "workspace event"
            meta = " · ".join(str(item.get(key)) for key in ("severity", "type", "role", "owner") if item.get(key))
            label = f"{meta}: {message}" if meta else str(message)
        else:
            label = str(item)
        parts.append(f'<li>{esc(label)}</li>')
    parts.append('</ul>')
else:
    parts.append('<p class="muted">No blockers or warnings.</p>')
parts.append('</section>')
parts.append('<section class="bay" aria-label="Reports"><h2>Reports</h2>')
reports = data.get("reports", {})
parts.append(f'<p class="muted">Reports: {esc(reports.get("submitted_selected_roles", 0))}/{esc(reports.get("required_selected_roles", 0))}</p></section>')
parts.append('</main><aside class="bay" aria-label="Snapshot evidence"><h2>CLI snapshot</h2><p>This static HTML is generated from <code>agentdock workspace snapshot --json</code>. It has no desktop runtime, no command bridge, and no bundled visual assets.</p></aside></div>')
parts.append('<h2>Snapshot JSON</h2><pre id="snapshot" aria-label="Embedded workspace snapshot JSON">')
parts.append(esc(json.dumps(data, ensure_ascii=False, indent=2)))
parts.append('</pre>\n</body></html>\n')
out.write_text("\n".join(parts), encoding="utf-8")
PY
  rm -f "$tmp"
  say "Workspace export: $out"
}

persist_hermes_global_model() {
  local model="$1" provider="${2:-}"
  have hermes || return 1
  hermes config set model.default "$model" >/dev/null 2>&1 || return 1
  if [[ -n "$provider" ]]; then
    hermes config set model.provider "$provider" >/dev/null 2>&1 || return 1
  fi
  return 0
}

apply_hermes_model_to_running_roles() {
  local root="$1" model="$2" provider="${3:-}" role pane first=1 applied_count=0 command
  local applied_json=""
  have tmux || { printf '0\t[]\n'; return 0; }
  command="/model $model"
  [[ -n "$provider" ]] && command="$command --provider $provider"
  command="$command --global"
  for role in $AGENT_IDS; do
    pane="$(cd "$root" && tmux_target_for_role "$role" 1 "$root" || true)"
    [[ -n "$pane" ]] || continue
    tmux send-keys -t "$pane" "$command" C-m || continue
    [[ "$first" == 1 ]] || applied_json="$applied_json, "
    first=0
    applied_json="$applied_json$(json_string "$role")"
    applied_count=$((applied_count + 1))
  done
  printf '%s\t[%s]\n' "$applied_count" "$applied_json"
}

cmd_workspace_model() {
  local root="$1"
  shift || true
  source_runtime "$root"
  local sub="${1:---json}" model="" provider="" json=0 apply_running=0 persist_global=0 applied_count=0 applied_roles="[]" global_persisted=false apply_result
  if [[ "$sub" == "--json" || "$sub" == "get" || -z "$sub" ]]; then
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --json|get) json=1; shift ;;
        --project) shift 2 ;;
        --project=*) shift ;;
        *) shift ;;
      esac
    done
    workspace_model_state_json
    printf '\n'
    return 0
  fi
  [[ "$sub" == "set" ]] || die "usage: agentdock workspace model --json | workspace model set --model <id> [--provider <id>] [--apply-running] [--global] --json"
  shift || true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --model) model="${2:-}"; shift 2 ;;
      --model=*) model="${1#*=}"; shift ;;
      --provider) provider="${2:-}"; shift 2 ;;
      --provider=*) provider="${1#*=}"; shift ;;
      --apply-running) apply_running=1; shift ;;
      --global) persist_global=1; shift ;;
      --json) json=1; shift ;;
      --project) shift 2 ;;
      --project=*) shift ;;
      *) die "unknown workspace model option: $1" ;;
    esac
  done
  validate_hermes_model_value "$model"
  validate_hermes_provider_value "$provider"
  [[ -n "$provider" ]] || provider="$(workspace_provider_value)"
  HERMES_MODEL="$model"
  HERMES_PROVIDER="$provider"
  write_runtime "$root" "$PROJECT_NAME" "$SESSION_NAME" "$LAYOUT" "$AGENT_IDS"
  if [[ "$persist_global" == 1 ]]; then
    if persist_hermes_global_model "$model" "$provider"; then
      global_persisted=true
    fi
  fi
  if [[ "$apply_running" == 1 ]]; then
    apply_result="$(apply_hermes_model_to_running_roles "$root" "$model" "$provider")"
    applied_count="${apply_result%%$'\t'*}"
    applied_roles="${apply_result#*$'\t'}"
  fi
  if [[ "$json" == 1 ]]; then
    printf '{"ok":true,"message":'
    json_string "AI model saved for AgentDock Hermes roles."
    printf ',"provider":'; json_string "$provider"
    printf ',"model":'; json_string "$model"
    printf ',"source":"project"'
    printf ',"global_persisted":%s' "$global_persisted"
    printf ',"applied_running_count":%s' "$applied_count"
    printf ',"applied_roles":%s' "$applied_roles"
    printf ',"options":'
    workspace_model_options_json | tr -d '\n'
    printf '}\n'
  else
    say "AI model saved for AgentDock Hermes roles: $provider / $model"
    [[ "$applied_count" -gt 0 ]] && say "Applied to $applied_count running role(s)."
  fi
}

cmd_workspace_perf() {
  local root="$1" json=0 start end duration_ms status_dir_count report_count job_count
  shift || true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json=1; shift ;;
      --project) shift 2 ;;
      --project=*) shift ;;
      *) shift ;;
    esac
  done
  start="$(date +%s%3N 2>/dev/null || date +%s000)"
  if workspace_snapshot_json "$root" >/dev/null; then
    end="$(date +%s%3N 2>/dev/null || date +%s000)"
    duration_ms=$((end - start))
  else
    end="$(date +%s%3N 2>/dev/null || date +%s000)"
    duration_ms=$((end - start))
  fi
  status_dir_count="$(find "$root/.agent-work/15_STATUS" -maxdepth 1 -type f -name '*.json' 2>/dev/null | wc -l | tr -d ' ')"
  report_count="$(find "$root/.agent-work/10_REPORTS" -type f -name '*.md' 2>/dev/null | wc -l | tr -d ' ')"
  job_count="$(find "$root/.agent-work/07_JOBS" -maxdepth 1 -type d -name 'JOB-*' 2>/dev/null | wc -l | tr -d ' ')"
  if [[ "$json" == 1 ]]; then
    printf '{"schema_version":"agentdock.workspace_perf.v1","snapshot_duration_ms":%s,"role_status_files":%s,"report_files":%s,"job_count":%s,"watch_scan_file_limit":1800}\n' "$duration_ms" "$status_dir_count" "$report_count" "$job_count"
  else
    say "Snapshot duration: ${duration_ms}ms"
    say "Role status files: $status_dir_count"
    say "Report files: $report_count"
    say "Jobs: $job_count"
  fi
}

workspace_snapshot_cached() {
  local root="$1" cache_ms="${2:-0}" cache="$root/.agentdock/state/workspace-snapshot-cache.json" tmp
  [[ "$cache_ms" =~ ^[0-9]+$ ]] || cache_ms=0
  if (( cache_ms > 0 )) && [[ -f "$cache" ]]; then
    if python3 - "$cache" "$cache_ms" >/dev/null <<'PY'
import sys, time
from pathlib import Path
path = Path(sys.argv[1])
ttl_ms = int(sys.argv[2])
age_ms = (time.time() - path.stat().st_mtime) * 1000
raise SystemExit(0 if age_ms <= ttl_ms else 1)
PY
    then
      cat "$cache"
      return 0
    fi
  fi
  if (( cache_ms > 0 )); then
    mkdir -p "$(dirname "$cache")"
    tmp="$(mktemp "${TMPDIR:-/tmp}/agentdock-snapshot-cache.XXXXXX")"
    workspace_snapshot_json "$root" > "$tmp"
    mv "$tmp" "$cache"
    cat "$cache"
  else
    workspace_snapshot_json "$root"
  fi
}

cmd_workspace() {
  local sub="${1:-}" root out=""
  shift || true
  root="$(require_project "$@")"
  case "$sub" in
    snapshot)
      local json=0 cache_ms=0
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --json) json=1; shift ;;
          --cache-ms) cache_ms="${2:-0}"; shift 2 ;;
          --project) shift 2 ;;
          --project=*) shift ;;
          *) die "usage: agentdock workspace snapshot --json [--cache-ms <ms>]" ;;
        esac
      done
      [[ "$json" == 1 ]] || die "usage: agentdock workspace snapshot --json [--cache-ms <ms>]"
      workspace_snapshot_cached "$root" "$cache_ms"
      ;;
    export)
      while [[ $# -gt 0 ]]; do
        case "$1" in
          --out) out="${2:-}"; shift 2 ;;
          --project) shift 2 ;;
          --project=*) shift ;;
          *) die "usage: agentdock workspace export --out <file>" ;;
        esac
      done
      workspace_export_html "$root" "$out"
      ;;
    model)
      cmd_workspace_model "$root" "$@"
      ;;
    perf)
      cmd_workspace_perf "$root" "$@"
      ;;
    *) die "usage: agentdock workspace snapshot --json | workspace export --out <file> | workspace model --json | workspace perf --json" ;;
  esac
}

cmd_install() {
  local id="${1:-}" method="" yes=0
  [[ -n "$id" ]] || die "usage: agentdock install <tool|cli> [--method npm] [--yes]"
  shift || true
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --method) method="${2:-}"; shift 2 ;;
      --yes) yes=1; shift ;;
      *) shift ;;
    esac
  done
  case "$id" in
    tmux|git|node|nodejs|npm)
      ensure_system_tool "$id" "$yes"
      ;;
    *)
      install_adapter "$id" "$method" "$yes"
      ;;
  esac
}

cmd_update() {
  local check=0 yes=0 current latest
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --check) check=1; shift ;;
      --yes) yes=1; shift ;;
      *) shift ;;
    esac
  done
  if git -C "$INSTALL_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    current="$(git -C "$INSTALL_ROOT" rev-parse --short HEAD 2>/dev/null || printf unknown)"
    git -C "$INSTALL_ROOT" fetch --tags origin >/dev/null 2>&1 || true
    latest="$(git -C "$INSTALL_ROOT" rev-parse --short origin/main 2>/dev/null || printf unknown)"
    if [[ "$check" == 1 || "$yes" != 1 ]]; then
      say "AgentDock version: $AGENTDOCK_VERSION"
      say "Current source commit: $current"
      say "Latest origin/main: $latest"
      [[ "$yes" == 1 ]] || say "Run: agentdock update --yes"
      return 0
    fi
    git -C "$INSTALL_ROOT" pull --ff-only
    if [[ -x "$INSTALL_ROOT/install.sh" ]]; then
      "$INSTALL_ROOT/install.sh"
    else
      say "Source updated. install.sh not found or not executable; using current source tree only."
    fi
    say "AgentDock updated from source commit $current to $(git -C "$INSTALL_ROOT" rev-parse --short HEAD 2>/dev/null || printf unknown)"
  else
    say "AgentDock version: $AGENTDOCK_VERSION"
    say "This install is not backed by a git source tree at $INSTALL_ROOT."
    say "Install/update from the release source or rerun install.sh from your downloaded AgentDock package."
  fi
}

cmd_uninstall() {
  local yes=0 prefix="${AGENTDOCK_PREFIX:-/usr/local}" bin_dir share_dir removed=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --yes) yes=1; shift ;;
      --prefix) prefix="${2:-/usr/local}"; shift 2 ;;
      *) shift ;;
    esac
  done
  bin_dir="$prefix/bin"
  share_dir="$prefix/share/agentdock"
  [[ "$yes" == 1 ]] || {
    say "This removes installed AgentDock binaries/share files only; project .agentdock and .agent-work are preserved."
    say "Run: agentdock uninstall --yes"
    return 0
  }
  for name in agentdock adock adock-delegate agentdock-delegate; do
    if [[ -e "$bin_dir/$name" || -L "$bin_dir/$name" ]]; then
      rm -f "$bin_dir/$name"
      removed=$((removed + 1))
    fi
  done
  if [[ -d "$share_dir" ]]; then
    rm -rf "$share_dir"
    removed=$((removed + 1))
  fi
  say "Uninstalled AgentDock install files from $prefix ($removed item groups removed)."
  say "Project state directories were not removed."
}

main() {
  require_bash_version
  local cmd="${1:-help}"
  shift || true
  if [[ "$CLI_NAME" == "adock-delegate" || "$CLI_NAME" == "agentdock-delegate" ]]; then
    case "$cmd" in
      help|--help|-h)
        say "Usage: $CLI_NAME [--from <role>] --request \"...\" [--project <path>]"
        say "Hermes-facing compatibility helper for: agentdock intake."
        return
        ;;
    esac
    cmd_delegate "$cmd" "$@"
    return
  fi
  case "$cmd" in
	    help|--help|-h) usage ;;
	    version|--version) say "agentdock $AGENTDOCK_VERSION" ;;
	    doctor) cmd_doctor "$@" ;;
	    setup) cmd_setup "$@" ;;
	    cli)
	      case "${1:-}" in
	        list) shift; cmd_cli_list "$@" ;;
	        add) shift; cmd_cli_add "$@" ;;
	        *) die "usage: agentdock cli list|add" ;;
	      esac ;;
	    roles) cmd_roles "$@" ;;
	    install) cmd_install "$@" ;;
    init) cmd_init "$@" ;;
    role) cmd_role_add "$@" ;;
    assign) cmd_assign "$@" ;;
    recruit) cmd_recruit "$@" ;;
    team) cmd_team "$@" ;;
    start) cmd_start "$@" ;;
    stop) cmd_stop "$@" ;;
    job) cmd_job "$@" ;;
    task) cmd_task "$@" ;;
    intake) cmd_intake "$@" ;;
    delegate) cmd_delegate "$@" ;;
    send) cmd_send "$@" ;;
    broadcast) cmd_broadcast "$@" ;;
    inbox) cmd_inbox "$@" ;;
    watch) cmd_watch "$@" ;;
    report) cmd_report "$@" ;;
    workspace) cmd_workspace "$@" ;;
    status) cmd_status "$@" ;;
    worktree) cmd_worktree "$@" ;;
    update) cmd_update "$@" ;;
    uninstall) cmd_uninstall "$@" ;;
    *) die "unknown command: $cmd" ;;
  esac
}

main "$@"
