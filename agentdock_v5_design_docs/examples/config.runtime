PROJECT_NAME="pons-sfu"
PROJECT_ROOT="/home/declan/Documents/Develop/Project/pons_sfu"
SESSION_NAME="pons-sfu-agents"
LAYOUT="hybrid"
ATTACH_ON_START="1"
USE_WORKTREES="0"
WORK_DIR=".agent-work"
WORKTREE_ROOT="../pons_sfu-agent-worktrees"
DEFAULT_RECIPIENT="orchestrator"

AGENT_IDS="orchestrator backend frontend qa"

AGENT_orchestrator_DISPLAY_NAME="Orchestrator"
AGENT_orchestrator_CLI="gemini"
AGENT_orchestrator_CMD="gemini"
AGENT_orchestrator_PROMPT=".agentdock/prompts/orchestrator.md"
AGENT_orchestrator_BOOT=".agentdock/generated/boot-orchestrator.md"
AGENT_orchestrator_WINDOW="command-center"
AGENT_orchestrator_CWD_MODE="project_root"

AGENT_backend_DISPLAY_NAME="Backend Engineer"
AGENT_backend_CLI="codex"
AGENT_backend_CMD="codex"
AGENT_backend_PROMPT=".agentdock/prompts/backend.md"
AGENT_backend_BOOT=".agentdock/generated/boot-backend.md"
AGENT_backend_WINDOW="implementation"
AGENT_backend_CWD_MODE="project_root"

AGENT_frontend_DISPLAY_NAME="Frontend Engineer"
AGENT_frontend_CLI="opencode"
AGENT_frontend_CMD="opencode"
AGENT_frontend_PROMPT=".agentdock/prompts/frontend.md"
AGENT_frontend_BOOT=".agentdock/generated/boot-frontend.md"
AGENT_frontend_WINDOW="implementation"
AGENT_frontend_CWD_MODE="project_root"

AGENT_qa_DISPLAY_NAME="QA Reviewer"
AGENT_qa_CLI="codex"
AGENT_qa_CMD="codex"
AGENT_qa_PROMPT=".agentdock/prompts/qa.md"
AGENT_qa_BOOT=".agentdock/generated/boot-qa.md"
AGENT_qa_WINDOW="quality-docs"
AGENT_qa_CWD_MODE="project_root"
